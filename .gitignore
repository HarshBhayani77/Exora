# Root .gitignore for Exora Monorepo

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment files & Secrets (CRITICAL: Never commit secrets)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Private keys, certificates, credentials
*.pem
*.key
*.keystore
*.pfx
*.p12
*.cer
*.crt
credentials.json
serviceAccountKey*.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server*.log

# Next.js build outputs
.next/
out/
build/
dist/
build-output/

# Testing & coverage
coverage/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel & Netlify
.vercel
.netlify
*.lighthouse.json
exoras.netlify.*.json

# Local Databases, dumps, Docker data volumes
*.sqlite
*.sqlite3
*.db
*.sql
*.dump
docker/data/
docker/pgdata/

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
